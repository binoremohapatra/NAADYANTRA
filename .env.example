# HazGuard Backend Configuration
# ─────────────────────────────────────────────────────────────
# LOCAL DEV  → copy this file to .env and fill in values
# RENDER     → paste each variable in Dashboard > Environment
# DO NOT commit .env to version control
# ─────────────────────────────────────────────────────────────


# ── DATABASE ─────────────────────────────────────────────────
# Local SQLite (dev only):
DATABASE_URL=sqlite:///./hazguard.db
# Render PostgreSQL (copy "Internal Database URL" from Render dashboard):
# DATABASE_URL=postgresql://user:password@host/dbname


# ── SERVER ───────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Set to "production" on Render
ENVIRONMENT=development


# ── SECURITY ─────────────────────────────────────────────────
# ⚠️ SECURITY: Generate a strong random secret for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ── DEVICE AUTH ──────────────────────────────────────────────
# ⚠️ SECURITY: Generate a secure device key and hash it with bcrypt
# NEVER use the default "dev-key-123" in production
# Generate key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate hash: python -c "from passlib.context import CryptContext; ctx = CryptContext(schemes=['bcrypt']); print(ctx.hash('your-device-key'))"
DEVICE_KEY_HASH=REPLACE_WITH_BCRYPT_HASH


# ── THRESHOLDS ───────────────────────────────────────────────
DEVICE_ONLINE_THRESHOLD_SECONDS=300


# ── CORS (Cross-Origin Resource Sharing) ─────────────────────
# ⚠️ SECURITY: Production requires explicit frontend origins
# Comma-separated list of allowed frontend URLs
# Required when ENVIRONMENT=production
# Example: CORS_ORIGINS=https://hazguard.onrender.com,https://your-frontend.com
# Development: If not set, allows all origins (wildcard)
CORS_ORIGINS=
